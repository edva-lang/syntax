// syntax/src/lang.dva — Supported languages, file extension detection, and keywords

#use path

#public
   LANG_PLAIN       = 0
   LANG_EDVA        = 1
   LANG_C           = 2
   LANG_CPP         = 3
   LANG_RUST        = 4
   LANG_PYTHON      = 5
   LANG_SHELL       = 6
   LANG_JSON        = 7
   LANG_TOML        = 8
   LANG_MARKDOWN    = 9
   LANG_HTML        = 10
   LANG_DIFF        = 11
   LANG_GO          = 12
   LANG_ZIG         = 13
   LANG_JS          = 14
   LANG_TS          = 15
   LANG_CCL         = 16
   LANG_MAKEFILE    = 17
   LANG_ODIN        = 18
   LANG_NUSHELL     = 19

   // Extract filename / basename from path
   basename: String => String
   basename = p => path::basename(p)

   // Extract file extension in lowercase (without the leading dot)
   extension: String => String
   extension = p => path::ext_lower(p)

   // Detect language ID from path or filename
   detect_language: String => Int
   detect_language = path =>
      base = basename(path)
      base_lang =
         base
            ["Makefile", "makefile", "GNUmakefile"] LANG_MAKEFILE
            ["Dockerfile", "dockerfile"]            LANG_SHELL
            ["edva.ccl", "edva.lock.ccl"]           LANG_CCL
            ["Cargo.toml", "Cargo.lock"]            LANG_TOML
            | LANG_PLAIN
      base_lang != LANG_PLAIN | --| base_lang

      ext = extension(path)
      ext
         ["dva"]                                  LANG_EDVA
         ["c", "h"]                               LANG_C
         ["cpp", "hpp", "cc", "hh", "cxx", "hxx"] LANG_CPP
         ["rs"]                                   LANG_RUST
         ["py", "pyw", "pyi"]                     LANG_PYTHON
         ["sh", "bash", "zsh", "fish", "env"]     LANG_SHELL
         ["json"]                                 LANG_JSON
         ["toml"]                                 LANG_TOML
         ["ccl"]                                  LANG_CCL
         ["md", "markdown", "mdown", "mkd"]       LANG_MARKDOWN
         ["html", "htm", "xml", "svg"]            LANG_HTML
         ["diff", "patch"]                        LANG_DIFF
         ["go"]                                   LANG_GO
         ["zig"]                                  LANG_ZIG
         ["js", "mjs", "cjs", "jsx"]              LANG_JS
         ["ts", "mts", "cts", "tsx"]              LANG_TS
         ["odin"]                                 LANG_ODIN
         ["nu"]                                   LANG_NUSHELL
         | LANG_PLAIN

   // Check if language supports // line comments
   has_slash_slash_comment: Int => <>
   has_slash_slash_comment = [LANG_EDVA, LANG_C, LANG_CPP, LANG_RUST, LANG_GO, LANG_ZIG, LANG_JS, LANG_TS, LANG_ODIN]

   // Check if language supports /* ... */ block comments
   has_slash_star_comment: Int => <>
   has_slash_star_comment = [LANG_EDVA, LANG_C, LANG_CPP, LANG_RUST, LANG_GO, LANG_ZIG, LANG_JS, LANG_TS, LANG_JSON, LANG_ODIN]

   // Check if language supports # line comments
   has_hash_comment: Int => <>
   has_hash_comment = [LANG_PYTHON, LANG_SHELL, LANG_TOML, LANG_CCL, LANG_MAKEFILE, LANG_NUSHELL]

   // --- Language-Specific Keyword Sets ---
   is_edva_kw: String => <>
   is_edva_kw = ["if", "else", "for", "while", "do", "switch", "case", "default", "break", "continue", "return", "type", "public", "extern", "use", "pragma", "test"]

   is_c_kw: String => <>
   is_c_kw = ["if", "else", "for", "while", "do", "switch", "case", "default", "break", "continue", "return", "goto", "sizeof", "typedef", "struct", "union", "enum", "static", "const", "extern", "inline", "volatile", "auto", "register"]

   is_cpp_kw: String => <>
   is_cpp_kw = ["if", "else", "for", "while", "do", "switch", "case", "default", "break", "continue", "return", "goto", "sizeof", "typedef", "struct", "union", "enum", "static", "const", "extern", "inline", "volatile", "auto", "class", "public", "private", "protected", "template", "typename", "namespace", "using", "new", "delete", "virtual", "override", "final", "constexpr", "try", "catch", "throw", "noexcept", "explicit", "friend", "operator", "this"]

   is_rust_kw: String => <>
   is_rust_kw = ["as", "async", "await", "break", "const", "continue", "crate", "dyn", "else", "enum", "extern", "fn", "for", "if", "impl", "in", "let", "loop", "match", "mod", "move", "mut", "pub", "ref", "return", "self", "Self", "static", "struct", "super", "trait", "type", "unsafe", "use", "where", "while"]

   is_python_kw: String => <>
   is_python_kw = ["and", "as", "assert", "async", "await", "break", "class", "continue", "def", "del", "elif", "else", "except", "finally", "for", "from", "global", "if", "import", "in", "is", "lambda", "nonlocal", "not", "or", "pass", "raise", "return", "try", "while", "with", "yield"]

   is_shell_kw: String => <>
   is_shell_kw = ["if", "then", "else", "elif", "fi", "case", "esac", "for", "while", "until", "do", "done", "in", "function", "select", "time", "local", "export", "readonly", "return", "exit", "echo"]

   is_go_kw: String => <>
   is_go_kw = ["break", "case", "chan", "const", "continue", "default", "defer", "else", "fallthrough", "for", "func", "go", "goto", "if", "import", "interface", "map", "package", "range", "return", "select", "struct", "switch", "type", "var"]

   is_zig_kw: String => <>
   is_zig_kw = ["const", "var", "fn", "pub", "return", "if", "else", "switch", "while", "for", "break", "continue", "struct", "enum", "union", "error", "try", "catch", "defer", "errdefer", "test", "comptime", "inline", "export", "extern", "unreachable", "and", "or", "orelse"]

   is_js_ts_kw: String => <>
   is_js_ts_kw = ["function", "const", "let", "var", "return", "if", "else", "for", "while", "do", "switch", "case", "default", "break", "continue", "class", "interface", "type", "extends", "implements", "import", "export", "from", "as", "new", "this", "super", "async", "await", "yield", "try", "catch", "finally", "throw", "typeof", "instanceof", "in", "of", "debugger"]

   is_odin_kw: String => <>
   is_odin_kw = ["package", "import", "proc", "struct", "enum", "union", "return", "if", "else", "when", "for", "in", "switch", "case", "defer", "fallthrough", "break", "continue", "using", "inline", "distinct", "dynamic", "map", "bit_set"]

   is_nu_kw: String => <>
   is_nu_kw = ["def", "let", "mut", "const", "if", "else", "for", "in", "while", "loop", "match", "return", "export", "use", "module", "overlay", "source", "where", "parse", "lines", "open", "print", "error"]

   is_no_ident: String => <>
   is_no_ident = w => <->

   // Return keyword predicate for the given language
   is_keyword: Int => (String => <>)
   is_keyword =
      [LANG_EDVA] is_edva_kw
      [LANG_C] is_c_kw
      [LANG_CPP] is_cpp_kw
      [LANG_RUST] is_rust_kw
      [LANG_PYTHON] is_python_kw
      [LANG_SHELL] is_shell_kw
      [LANG_GO] is_go_kw
      [LANG_ZIG] is_zig_kw
      [LANG_JS, LANG_TS] is_js_ts_kw
      [LANG_ODIN] is_odin_kw
      [LANG_NUSHELL] is_nu_kw
      | is_no_ident

   // --- Language-Specific Type Sets ---
   is_edva_type_name: String => <>
   is_edva_type_name = ["Int", "String", "Rune", "Float", "Addr", "Address", "Builder", "Error", "Type", "u8", "u16", "u32", "u64", "i1", "i8", "i16", "i32", "i64", "f32", "f64", "float", "double", "void", "ptr"]

   is_c_type_name: String => <>
   is_c_type_name = ["int", "char", "short", "long", "float", "double", "void", "unsigned", "signed", "size_t", "ssize_t", "uint8_t", "uint16_t", "uint32_t", "uint64_t", "int8_t", "int16_t", "int32_t", "int64_t", "bool", "uintptr_t", "intptr_t", "string", "vector", "map", "unique_ptr", "shared_ptr"]

   is_rust_type_name: String => <>
   is_rust_type_name = ["bool", "char", "str", "u8", "u16", "u32", "u64", "u128", "usize", "i8", "i16", "i32", "i64", "i128", "isize", "f32", "f64", "Option", "Result", "String", "Vec", "Box", "Rc", "Arc"]

   is_python_type_name: String => <>
   is_python_type_name = ["int", "str", "float", "bool", "list", "dict", "set", "tuple", "bytes", "object", "type"]

   is_go_type_name: String => <>
   is_go_type_name = ["bool", "byte", "complex64", "complex128", "error", "float32", "float64", "int", "int8", "int16", "int32", "int64", "rune", "string", "uint", "uint8", "uint16", "uint32", "uint64", "uintptr"]

   is_zig_type_name: String => <>
   is_zig_type_name = ["bool", "i8", "u8", "i16", "u16", "i32", "u32", "i64", "u64", "isize", "usize", "f16", "f32", "f64", "f128", "void", "anyerror", "type"]

   is_ts_type_name: String => <>
   is_ts_type_name = ["string", "number", "boolean", "any", "void", "never", "unknown", "object", "symbol", "bigint", "Array", "Record", "Promise"]

   is_odin_type_name: String => <>
   is_odin_type_name = ["int", "uint", "string", "cstring", "rawptr", "bool", "b8", "b32", "i8", "i16", "i32", "i64", "u8", "u16", "u32", "u64", "f32", "f64"]

   is_nu_type_name: String => <>
   is_nu_type_name = ["string", "int", "float", "bool", "path", "duration", "date", "filesize", "record", "table", "list", "binary"]

   // Return standard type predicate for the given language
   is_type: Int => (String => <>)
   is_type =
      [LANG_EDVA] is_edva_type_name
      [LANG_C, LANG_CPP] is_c_type_name
      [LANG_RUST] is_rust_type_name
      [LANG_PYTHON] is_python_type_name
      [LANG_GO] is_go_type_name
      [LANG_ZIG] is_zig_type_name
      [LANG_TS] is_ts_type_name
      [LANG_ODIN] is_odin_type_name
      [LANG_NUSHELL] is_nu_type_name
      | is_no_ident

   // Check if an identifier is a standard constant (boolean, null, none)
   is_constant: String => <>
   is_constant = ["true", "false", "True", "False", "null", "NULL", "nullptr", "nil", "None", "undefined", "NaN"]
